&lt;div class="wechat-article-content">&lt;section data-mpa-md-root="t" data-mpa-uuid="cfa01603b2514237dc8ad4e39723ac84" data-review-block-id="arb_mvouzq71_zv8ra2ss">&lt;section data-pm-slice='3 4 ["para",{"tagName":"section","attributes":{"style":"box-sizing: border-box;font-style: normal;font-weight: 400;text-align: justify;font-size: 16px;color: rgb(62, 62, 62);"},"namespaceURI":"http://www.w3.org/1999/xhtml","data-layout-id":null}]' data-review-block-id="arb_mvouzq71_xxfshu0o">&lt;section data-review-block-id="arb_mvouzq71_x8x717b4" nodeleaf="">&lt;img decoding="async" loading="lazy" src="https://sensor.fans/images/wx/wechat-abyg9ozbkafjgjch201cgq-001-3f4ad90a82e6.gif"/>&lt;/section>&lt;section data-review-block-id="arb_mvouzq71_8ze7c6y0">&lt;span leaf="">&lt;br/>&lt;/span>&lt;/section>&lt;p data-pm-slice="0 0 []" data-review-block-id="arb_mvouzq71_j83iepz1">&lt;span leaf="">&lt;span textstyle="">把技术做成产品，把实践写进国标——中国人形机器人的产业实力，正从头部企业一线经验里生长出来。&lt;/span>&lt;/span>&lt;/p>&lt;section data-pm-slice="2 4 []" data-review-block-id="arb_mvouzq71_gwmkdypd">&lt;section data-review-block-id="arb_mvouzq71_6gixcl9p" nodeleaf="">&lt;img decoding="async" loading="lazy" src="https://sensor.fans/images/wx/wechat-abyg9ozbkafjgjch201cgq-002-3fe34a9595ac.png"/>&lt;/section>&lt;section data-review-block-id="arb_mvouzq71_sbr9fthz">&lt;section data-pm-slice="2 4 []" data-review-block-id="arb_mvouzq71_tk8rlcyn">&lt;section data-pm-slice="2 4 []" data-review-block-id="arb_mvouzq71_93y8t55g">&lt;p data-pm-slice="0 0 []" data-review-block-id="arb_mvouzq71_59db25ci">&lt;span leaf="">&lt;span textstyle="">央视新闻报道首批人形机器人国家标准发布&lt;/span>&lt;/span>&lt;/p>&lt;/section>&lt;/section>&lt;/section>&lt;/section>&lt;section data-pm-slice="2 4 []" data-review-block-id="arb_mvouzq71_fqzjwae9">&lt;h2 data-pm-slice="0 0 []" data-review-block-id="arb_mvouzq71_1071jq0t">&lt;span leaf="">&lt;span textstyle="">近期，《人形机器人技术要求》系列首批5项国家标准正式发布，帕西尼作为主要起草单位之一，深度参&lt;/span>&lt;/span>&lt;span leaf="">&lt;span textstyle="">与《环境感知》《决策规划》《运动控制》3项标准编制。这三项标准恰好贯穿人形机器人从感知、决策到执行的核心链路，&lt;/span>&lt;span textstyle="">全部落在人形机器人的核心能力上&lt;/span>&lt;span textstyle="">。&lt;/span>&lt;/span>&lt;/h2>&lt;/section>&lt;/section>&lt;/section>&lt;p data-pm-slice="0 0 []" data-review-block-id="arb_mvouzq71_4zekk594">&lt;span leaf="">&lt;span textstyle="">这组“&lt;/span>&lt;/span>&lt;span leaf="">&lt;span textstyle="">3/5”背后，既有帕西尼持续参与标准建设的行业积累，更集中呈现了帕西尼贯通不同技术环节的全栈能力及规模交付验证的工程实力。&lt;/span>&lt;/span>&lt;/p></description></item></channel></rss>